{
  "name": "pipeline-doc",
  "displayName": "PipelineDoc",
  "description": "Auto-generate documentation from ETL pipelines (Talend, ADF, Microsoft Fabric) using AI",
  "version": "0.1.0",
  "publisher": "xHolst",
  "author": {
    "name": "Charlotte Holst",
    "url": "https://github.com/CharlotteH86"
  },
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CharlotteH86/pipeline-doc"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "talend",
    "adf",
    "azure data factory",
    "fabric",
    "etl",
    "pipeline",
    "documentation",
    "ai"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pipeline-doc.generateFromItem",
        "title": "PipelineDoc: Generate Documentation from .item file"
      },
      {
        "command": "pipeline-doc.generateFromJson",
        "title": "PipelineDoc: Generate Documentation from ADF / Fabric / Talend JSON"
      },
      {
        "command": "pipeline-doc.setOpenAIKey",
        "title": "PipelineDoc: Set OpenAI API Key"
      },
      {
        "command": "pipeline-doc.setAnthropicKey",
        "title": "PipelineDoc: Set Anthropic API Key"
      },
      {
        "command": "pipeline-doc.openSettings",
        "title": "PipelineDoc: Open Settings"
      },
      {
        "command": "pipeline-doc.openRecentDoc",
        "title": "PipelineDoc: Open Document"
      },
      {
        "command": "pipeline-doc.refreshSidebar",
        "title": "PipelineDoc: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pipelineDocSidebar",
          "title": "PipelineDoc",
          "icon": "sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "pipelineDocSidebar": [
        {
          "id": "pipelineDocView",
          "name": "PipelineDoc"
        }
      ]
    },
    "configuration": {
      "title": "PipelineDoc",
      "properties": {
        "pipelineDoc.aiProvider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "premium"
          ],
          "default": "premium",
          "description": "Which AI provider to use for documentation generation"
        },
        "pipelineDoc.outputLanguage": {
          "type": "string",
          "enum": [
            "svenska",
            "english"
          ],
          "default": "english",
          "description": "Language for generated documentation"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "pipeline-doc.refreshSidebar",
          "when": "view == pipelineDocView",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "pipeline-doc.generateFromItem",
          "when": "resourceExtname == .item",
          "group": "navigation"
        },
        {
          "command": "pipeline-doc.generateFromJson",
          "when": "resourceExtname == .json",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "fast-xml-parser": "^4.3.0"
  }
}
