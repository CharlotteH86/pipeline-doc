{
  "name": "pipeline-doc",
  "displayName": "PipelineDoc",
  "description": "Auto-generate documentation from ETL pipelines (Talend, ADF, Microsoft Fabric) using AI",
  "version": "0.1.2",
  "publisher": "xHolst",
  "author": {
    "name": "Charlotte Holst",
    "url": "https://github.com/CharlotteH86"
  },
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CharlotteH86/pipeline-doc"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "talend",
    "adf",
    "azure data factory",
    "fabric",
    "etl",
    "pipeline",
    "documentation",
    "ai"
  ],
  "activationEvents": [
    "onView:pipelineDocView",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pipeline-doc.generateFromItem",
        "title": "PipelineDoc: Generate Documentation from .item file"
      },
      {
        "command": "pipeline-doc.generateFromJson",
        "title": "PipelineDoc: Generate Documentation from ADF / Fabric / Talend JSON"
      },
      {
        "command": "pipeline-doc.generateBatch",
        "title": "PipelineDoc: Generate Documentation for Folder (Batch)"
      },
      {
        "command": "pipeline-doc.setOpenAIKey",
        "title": "PipelineDoc: Set OpenAI API Key"
      },
      {
        "command": "pipeline-doc.setAnthropicKey",
        "title": "PipelineDoc: Set Anthropic API Key"
      },
      {
        "command": "pipeline-doc.openSettings",
        "title": "PipelineDoc: Open Settings"
      },
      {
        "command": "pipeline-doc.openRecentDoc",
        "title": "PipelineDoc: Open Document"
      },
      {
        "command": "pipeline-doc.refreshSidebar",
        "title": "PipelineDoc: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pipelineDocSidebar",
          "title": "PipelineDoc",
          "icon": "sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "pipelineDocSidebar": [
        {
          "id": "pipelineDocView",
          "name": "PipelineDoc"
        }
      ]
    },
    "configuration": {
      "title": "PipelineDoc",
      "properties": {
        "pipelineDoc.aiProvider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "premium"
          ],
          "default": "premium",
          "description": "Which AI provider to use for documentation generation"
        },
        "pipelineDoc.outputLanguage": {
          "type": "string",
          "enum": [
            "svenska",
            "english"
          ],
          "default": "english",
          "description": "Language for generated documentation"
        },
        "pipelineDoc.openaiModel": {
          "type": "string",
          "default": "gpt-4o-mini",
          "examples": [
            "gpt-4o-mini",
            "gpt-4o",
            "gpt-4.1-mini"
          ],
          "description": "Which OpenAI model to use for documentation generation. Any valid OpenAI model ID is accepted, not just the suggestions."
        },
        "pipelineDoc.anthropicModel": {
          "type": "string",
          "default": "claude-sonnet-4-6",
          "examples": [
            "claude-sonnet-4-6",
            "claude-opus-4-1",
            "claude-haiku-4-5"
          ],
          "description": "Which Anthropic model to use for documentation generation. Any valid Anthropic model ID is accepted, not just the suggestions."
        },
        "pipelineDoc.batchConcurrency": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 20,
          "description": "Max number of pipelines to document in parallel during Batch Generation. Lower this if you hit API rate-limit (429) errors."
        },
        "pipelineDoc.tier": {
          "type": "string",
          "enum": [
            "free",
            "premium"
          ],
          "default": "free",
          "description": "(Temporary) Local flag to unlock Premium features such as Batch Generation for testing. Will be replaced by real license validation before release."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "pipeline-doc.refreshSidebar",
          "when": "view == pipelineDocView",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "pipeline-doc.generateFromItem",
          "when": "resourceExtname == .item",
          "group": "navigation"
        },
        {
          "command": "pipeline-doc.generateFromJson",
          "when": "resourceExtname == .json",
          "group": "navigation"
        },
        {
          "command": "pipeline-doc.generateBatch",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --format=cjs --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --format=cjs --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "package": "npm run compile && npx @vscode/vsce package",
    "publish": "npm run compile && npx @vscode/vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.9.3"
  }
}
